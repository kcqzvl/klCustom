<Window x:Class="StartStyleToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kcqzvl-Customize" Width="1220" Height="765" MinWidth="980" MinHeight="690"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        </Style>
        <Style x:Key="ToolMenu" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="6" Padding="4">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Base" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource HoverLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Base" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Base" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Base" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource SelectedLine}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource HoverLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Base" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3" BorderThickness="1"
                                    Background="{DynamicResource Field}" BorderBrush="{DynamicResource HoverLine}"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="Mark" Data="M 0,4 L 3,7 L 8,1"
                                      Stroke="{DynamicResource PrimaryInk}" StrokeThickness="1.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Primary}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="3" Background="{DynamicResource SliderTrack}" CornerRadius="2"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="3" Background="{DynamicResource SliderFill}" CornerRadius="2"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Accent}" Stroke="{DynamicResource Field}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="11,10"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Base" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Base" Property="Background" Value="{DynamicResource Selected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="24,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Width="38" Height="38" Background="{DynamicResource Selected}" CornerRadius="6">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="kcqzvl-Customize" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Secondary}" Text="Windows 11 · 25H2"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock x:Name="DependencyStatus" Text="正在检查开始菜单" Style="{StaticResource Secondary}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Click="Dependencies_Click" ToolTip="重新检测开始菜单" AutomationProperties.Name="重新检测开始菜单">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="193"/>
                <ColumnDefinition Width="348"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,20,14,15" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Margin="10,0,0,12" Style="{StaticResource Secondary}" Text="开始菜单区域"/>
                    <Button DockPanel.Dock="Bottom" Click="RestoreAll_Click" x:Name="RestoreAllButton" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" Margin="0,0,7,0"/>
                            <TextBlock Text="全部恢复"/>
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="Regions" SelectionChanged="RegionChanged" BorderThickness="0"
                             Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="开始菜单区域">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" Margin="0,0,9,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,19,20,16">
                        <TextBlock x:Name="RegionTitle" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RegionStatus" Style="{StaticResource Secondary}" Margin="0,5,0,16"/>
                        <CheckBox x:Name="MainOwner" Content="由本工具管理主背景" Margin="0,0,0,14"
                                  Click="MainOwner_Click" Visibility="Collapsed"/>
                        <TextBlock Text="材质" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <UniformGrid x:Name="Materials" Columns="3" Rows="2" Margin="0,0,0,16"/>
                        <CheckBox x:Name="ShareMainBackdrop" Margin="0,0,0,12" Content="跟随主菜单背景"
                                  Click="ShareMainBackdrop_Click" Visibility="Collapsed"
                                  ToolTip="右侧面板复用主菜单的背景取样和色调"/>
                        <StackPanel x:Name="ColorEditor">
                            <DockPanel Margin="0,0,0,7" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="颜色" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" x:Name="PresetButton" Click="Preset_Click" Content="雾蓝紫" Padding="8,3"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="Swatch" Grid.Column="0" Width="40" Height="31" Padding="3"
                                        Click="Swatch_Click" ToolTip="选取颜色" AutomationProperties.Name="选取颜色">
                                    <Border x:Name="SwatchFill" Width="28" Height="21" CornerRadius="3"/>
                                </Button>
                                <TextBox x:Name="HexBox" Grid.Column="2" TextChanged="HexChanged" MaxLength="9"
                                         Height="31" FontFamily="Consolas" AutomationProperties.Name="十六进制颜色"/>
                            </Grid>
                            <UniformGrid x:Name="Channels" Columns="4" Rows="1" Margin="0,0,0,15"/>
                        </StackPanel>
                        <StackPanel x:Name="Sliders"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2" Margin="22,19,22,17">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="材质预览" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton x:Name="LightScene" GroupName="scene" Content="浅色网页" Checked="SceneChanged" IsChecked="True"/>
                        <RadioButton GroupName="scene" Content="深色窗口" Checked="SceneChanged"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" x:Name="PreviewFrame" Background="{DynamicResource PreviewWell}" CornerRadius="7"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
                    <Viewbox Margin="12" StretchDirection="DownOnly">
                        <ContentControl x:Name="PreviewContent"/>
                    </Viewbox>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Padding="19,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Panel}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Click="Copy_Click" Content="复制样式到…" Margin="0,0,8,0"/>
                    <Button x:Name="RestoreButton" Click="Restore_Click" Content="恢复此区域" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Click="Apply_Click" Content="应用" MinWidth="86"
                            ToolTipService.ShowOnDisabled="True"
                            Background="{DynamicResource Primary}" Foreground="{DynamicResource PrimaryInk}" BorderBrush="{DynamicResource Primary}"
                            FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" VerticalAlignment="Center"
                           Margin="0,0,16,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
